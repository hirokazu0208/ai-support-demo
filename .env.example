# Docker Compose 用の環境変数（このファイルを .env にコピーして値を設定する）
#   cp .env.example .env
# .env は Git 管理対象外。docker compose が自動で読み込み、compose.yaml で DATABASE_URL を組み立てる。
#
# POSTGRES_PASSWORD は DATABASE_URL（postgresql+psycopg://user:password@db:5432/db）に埋め込まれるため、
# URL で特別な意味を持つ記号（@ : / ? # % など）を含めないこと。次のコマンドで生成した値を推奨する:
#   openssl rand -hex 24

POSTGRES_DB=ai_support_desk
POSTGRES_USER=ai_support_desk
POSTGRES_PASSWORD=change-me
