# Docker Compose 用の環境変数（このファイルを .env にコピーして値を設定する）
#   cp .env.example .env
# .env は Git 管理対象外。docker compose が自動で読み込み、compose.yaml で DATABASE_URL を組み立てる。
#
# POSTGRES_PASSWORD は DATABASE_URL（postgresql+psycopg://user:password@db:5432/db）に埋め込まれるため、
# URL で特別な意味を持つ記号（@ : / ? # % など）を含めないこと。次のコマンドで生成した値を推奨する:
#   openssl rand -hex 24

POSTGRES_DB=ai_support_desk
POSTGRES_USER=ai_support_desk
POSTGRES_PASSWORD=change-me

# --- AI Agent（Demo 3 Step 5。backend コンテナにだけ渡す）-------------------------------
# AGENT_PROVIDER の既定は rule（RuleBasedAgent。外部 LLM を使わず、API キーなしで動く）。
# openai にする場合だけ OPENAI_API_KEY と OPENAI_MODEL が必要（不足していると backend は起動時にエラー）。
# API キーは .env（Git 管理対象外）にだけ書く。frontend・compose.yaml・ソースコードには置かない。
# その他の上限値（AGENT_TIMEOUT_SECONDS など）は compose.yaml の既定値を使う。変える場合だけ追記する。
AGENT_PROVIDER=rule
OPENAI_API_KEY=
OPENAI_MODEL=
